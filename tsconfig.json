{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "core/**/*.ts",
    "runtime/**/*.ts",
    "packages/**/*.ts",
    "infrastructure/**/*.ts",
    "modules/**/*.ts",
    "integrations/**/*.ts"
  ]
}
