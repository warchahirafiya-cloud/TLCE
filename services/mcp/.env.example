# Local-only defaults. Do not commit real credentials.
NODE_ENV=development
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8787
MCP_PUBLIC_URL=http://127.0.0.1:8787/mcp
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Hostnames only; the official SDK adapter compares hostnames, not full URLs.
MCP_ALLOWED_ORIGINS=127.0.0.1,localhost

# Required OAuth 2.0 token introspection endpoint (RFC 7662).
# Must use HTTPS outside local development.
MCP_OAUTH_INTROSPECTION_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_REQUIRED_SCOPES=mcp:connect
MCP_HEALTH_SCOPE=tlce:health:read
MCP_INTROSPECTION_TIMEOUT_MS=3000
